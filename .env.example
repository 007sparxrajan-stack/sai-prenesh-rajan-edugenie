# Required for Gemini-powered features
GEMINI_API_KEY=your_gemini_api_key_here

# Current stable model used by this project.
# Change this if your Google AI Studio account exposes another supported model.
GEMINI_MODEL=gemini-2.5-flash

APP_NAME=EduGenie
REQUEST_TIMEOUT_SECONDS=60

# Optional local explanation model.
# false = simpler setup and Gemini handles explanations.
# true  = tries MBZUAI/LaMini-Flan-T5-783M locally first.
ENABLE_LOCAL_EXPLAINER=false
LOCAL_MODEL_NAME=MBZUAI/LaMini-Flan-T5-783M
